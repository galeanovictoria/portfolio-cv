            <span style="width:9px; height:9px; border-radius:50%; background:#f4bf4f;"></span>
            <span style="width:9px; height:9px; border-radius:50%; background:#61c554;"></span>
            <div style="flex:1; margin-left:10px; min-width:0; font-family:'IBM Plex Mono',monospace; font-size:10px; color:var(--muted); background:var(--bg); border-radius:100px; padding:4px 12px; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">cloudcannon.com/templates/jetstream</div>
