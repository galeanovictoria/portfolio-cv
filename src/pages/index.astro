    <!-- CASE 02 — JETSTREAM -->
    <article data-reveal class="vr-case" style="display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; padding:64px 0; border-bottom:1px solid var(--line);">
      <div class="vr-case-media" style="order:2; display:flex; flex-direction:column; gap:16px;">
        <div style="position:relative; aspect-ratio:16/10; border:1.5px solid var(--ink); border-radius:16px; overflow:hidden; background:#0f0a1e; display:flex; flex-direction:column;" class="vr-mock">
