    <a href="#top" style="display:flex; flex-direction:column; justify-content:center; gap:1px; font-family:'Bricolage Grotesque',sans-serif; font-weight:800; font-size:17px; letter-spacing:-.01em; line-height:1;">
      Victoria Roberts
      <span style="font-family:'IBM Plex Mono',monospace; font-weight:400; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);">UX/UI Designer</span>
    </a>
    <div style="display:flex; align-items:center; gap:26px;">
      <div class="vr-nav-links" style="display:flex; gap:22px; font-family:'IBM Plex Mono',monospace; font-size:12.5px; letter-spacing:.04em;">
        <a href="#work" style="opacity:.75;" style-hover="opacity:1; color:var(--accent);">Work</a>
        <a href="#about" style="opacity:.75;" style-hover="opacity:1; color:var(--accent);">About</a>
        <a href="#writing" style="opacity:.75;" style-hover="opacity:1; color:var(--accent);">Writing</a>
        <a href="#contact" style="opacity:.75;" style-hover="opacity:1; color:var(--accent);">Contact</a>
