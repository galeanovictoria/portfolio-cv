<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  state = { theme: 'sol', wordIndex: 0, jetLight: false, docsLight: true };

  get words() { return ['love','trust','ship','remember','depend on']; }

  setTheme = (id) => this.setState({ theme: id });
  setJetLight = () => this.setState({ jetLight: true });
  setJetDark = () => this.setState({ jetLight: false });
  setDocsLight = () => this.setState({ docsLight: true });
  setDocsDark = () => this.setState({ docsLight: false });

  componentDidMount() {
    // Rotating hero word
    this._wordTimer = setInterval(() => {
      this.setState(s => ({ wordIndex: (s.wordIndex + 1) % this.words.length }));
    }, 2200);

    // Scroll reveals
    const els = Array.from(document.querySelectorAll('[data-reveal]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    els.forEach(el => {
      el.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
      if (reduce) { el.style.opacity = '1'; return; }
      el.style.opacity = '0';
      el.style.transform = 'translateY(22px)';
    });
    if (!reduce && 'IntersectionObserver' in window) {
      this._io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'none';
            this._io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      els.forEach(el => this._io.observe(el));
      // Safety: reveal everything after 3s regardless
      this._revealTimer = setTimeout(() => els.forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; }), 3000);
    }

    // Nav background on scroll
    this._nav = document.getElementById('vr-nav');
    this._onScroll = () => {
      if (!this._nav) return;
      if (window.scrollY > 40) {
        this._nav.style.background = 'color-mix(in srgb, var(--bg) 88%, transparent)';
        this._nav.style.backdropFilter = 'blur(10px)';
        this._nav.style.boxShadow = '0 1px 0 var(--line)';
        this._nav.style.padding = '12px 32px';
      } else {
        this._nav.style.background = 'color-mix(in srgb, var(--bg) 72%, transparent)';
        this._nav.style.backdropFilter = 'blur(7px)';
        this._nav.style.boxShadow = 'none';
        this._nav.style.padding = '18px 32px';
      }
    };
    window.addEventListener('scroll', this._onScroll, { passive: true });
    this._onScroll();

    this._initHero();
    this._initOrnaments();
  }

  componentDidUpdate() {
    this._orn = Array.from(document.querySelectorAll('[data-motif]'));
    this._drawOrnaments();
  }

  _initOrnaments() {
    this._orn = Array.from(document.querySelectorAll('[data-motif]'));
    this._drawOrnaments();
  }

  _drawOrnaments() {
    if (!this._orn || !this._orn.length) return;
    const root = document.querySelector('[data-theme]');
    if (!root) return;
    const accent = (getComputedStyle(root).getPropertyValue('--accent') || '#0b6e3c').trim();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const map = { mandala: this._mMandala, spiral: this._mSpiral, paisley: this._mPaisley, feather: this._mFeather, leaf: this._mLeaf, scallop: this._mScallop, squares: this._mSquares };
    this._orn.forEach((cv, idx) => {
      const name = cv.getAttribute('data-motif');
      const fn = map[name];
      if (!fn) return;
      const rct = cv.getBoundingClientRect();
      const wpx = rct.width || parseFloat(cv.style.width) || 44;
      const hpx = rct.height || wpx;
      cv.width = Math.floor(wpx * dpr);
      cv.height = Math.floor(hpx * dpr);
      const g = cv.getContext('2d');
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.clearRect(0, 0, wpx, hpx);
      g.strokeStyle = accent; g.fillStyle = accent;
      g.lineJoin = 'round'; g.lineCap = 'round'; g.lineWidth = 1.3;
      g.save();
      g.translate(wpx / 2, hpx / 2);
      fn.call(this, g, Math.min(wpx, hpx) / 2 * 0.82, this._mulberry(name.length * 97 + 13 + idx * 137));
      g.restore();
    });
  }

  componentWillUnmount() {
    clearInterval(this._wordTimer);
    clearTimeout(this._revealTimer);
    if (this._io) this._io.disconnect();
    window.removeEventListener('scroll', this._onScroll);
    cancelAnimationFrame(this._raf);
    clearTimeout(this._rt);
    if (this._ro) this._ro.disconnect();
    window.removeEventListener('pointermove', this._onMove);
  }

  _mulberry(a) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  _initHero() {
    const cv = document.querySelector('[data-hero-canvas]');
    if (!cv) return;
    this._cv = cv;
    this._ctx = cv.getContext('2d');
    if (!this._pattern) {
      const im = new Image();
      im.onload = () => { if (this._resizeHero) this._resizeHero(); };
      im.src = (window.__resources && window.__resources['/assets/hero-pattern.png']) || '/assets/hero-pattern.png';
      this._pattern = im;
    }
    this._mouse = { x: 0, y: 0 };
    this._target = { x: 0, y: 0 };
    this._has = false;
    const resize = () => {
      const r = cv.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      this._w = r.width; this._h = r.height; this._dpr = dpr;
      cv.width = Math.floor(r.width * dpr);
      cv.height = Math.floor(r.height * dpr);
      this._art = this._buildArt(r.width, r.height, dpr);
      this._spot = null;
      if (!this._has) { this._target = { x: r.width * 0.72, y: r.height * 0.48 }; this._mouse = { ...this._target }; }
    };
    this._resizeHero = resize;
    resize();
    this._ro = new ResizeObserver(() => { clearTimeout(this._rt); this._rt = setTimeout(resize, 160); });
    this._ro.observe(cv.parentElement || cv);
    this._onMove = (e) => {
      const r = cv.getBoundingClientRect();
      this._target = { x: e.clientX - r.left, y: e.clientY - r.top };
      this._has = true;
    };
    window.addEventListener('pointermove', this._onMove, { passive: true });
    const loop = (t) => { this._renderHero(t); this._raf = requestAnimationFrame(loop); };
    this._raf = requestAnimationFrame(loop);
  }

  _buildArt(w, h, dpr) {
    const c = document.createElement('canvas');
    c.width = Math.floor(w * dpr); c.height = Math.floor(h * dpr);
    const g = c.getContext('2d');
    g.scale(dpr, dpr);
    g.strokeStyle = '#141109'; g.fillStyle = '#141109';
    g.lineJoin = 'round'; g.lineCap = 'round';
    const rnd = this._mulberry(20260721);
    // Tile the real hand-drawn hexagon pattern as the base art; the rainbow spotlight reveals it on hover
    const img = this._pattern;
    if (img && img.complete && img.naturalWidth) {
      const tileW = 660;
      const tileH = Math.round(tileW * img.naturalHeight / img.naturalWidth);
      const tc = document.createElement('canvas');
      tc.width = tileW; tc.height = tileH;
      tc.getContext('2d').drawImage(img, 0, 0, tileW, tileH);
      const pat = g.createPattern(tc, 'repeat');
      g.fillStyle = pat;
      g.fillRect(0, 0, w, h);
    }
    return c;
  }

  _clipPoly(g, pts, fn) {
    g.save(); g.beginPath();
    pts.forEach((p, k) => k ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]));
    g.closePath(); g.clip(); fn(); g.restore();
  }

  _fHatch(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 6 + rnd() * 3; g.beginPath();
    for (let c = -h; c < w; c += s) { g.moveTo(x + c, y); g.lineTo(x + c + h, y + h); }
    g.stroke();
  }
  _fCross(g, x, y, w, h, rnd) {
    g.lineWidth = 0.85; const s = 7 + rnd() * 3; g.beginPath();
    for (let c = -h; c < w; c += s) { g.moveTo(x + c, y); g.lineTo(x + c + h, y + h); }
    for (let c = 0; c < w + h; c += s) { g.moveTo(x + c, y); g.lineTo(x + c - h, y + h); }
    g.stroke();
  }
  _fWaves(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 7 + rnd() * 3, amp = s * 0.42;
    for (let yy = y; yy <= y + h + s; yy += s) {
      g.beginPath();
      for (let xx = x; xx <= x + w; xx += 3) { const v = yy + Math.sin((xx - x) / (s * 1.5)) * amp; xx === x ? g.moveTo(xx, v) : g.lineTo(xx, v); }
      g.stroke();
    }
  }
  _fVWaves(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 7 + rnd() * 3, amp = s * 0.42;
    for (let xx = x; xx <= x + w + s; xx += s) {
      g.beginPath();
      for (let yy = y; yy <= y + h; yy += 3) { const v = xx + Math.sin((yy - y) / (s * 1.5)) * amp; yy === y ? g.moveTo(v, yy) : g.lineTo(v, yy); }
      g.stroke();
    }
  }
  _fDots(g, x, y, w, h, rnd) {
    const s = 8 + rnd() * 3, rr = s * 0.19;
    for (let yy = y + s / 2; yy < y + h; yy += s) for (let xx = x + s / 2; xx < x + w; xx += s) { g.beginPath(); g.arc(xx, yy, rr, 0, Math.PI * 2); g.fill(); }
  }
  _fArcsCorner(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const cx = x + (rnd() < 0.5 ? 0 : w), cy = y + (rnd() < 0.5 ? 0 : h);
    const s = 8 + rnd() * 3, max = Math.hypot(w, h);
    for (let rad = s; rad < max; rad += s) { g.beginPath(); g.arc(cx, cy, rad, 0, Math.PI * 2); g.stroke(); }
  }
  _fScales(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 10 + rnd() * 4; let row = 0;
    for (let yy = y; yy < y + h + s; yy += s * 0.6) {
      const off = (row % 2) ? s / 2 : 0;
      for (let xx = x - s; xx < x + w + s; xx += s) { g.beginPath(); g.arc(xx + off, yy, s / 2, Math.PI, 0); g.stroke(); }
      row++;
    }
  }
  _fBricks(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const bh = 9 + rnd() * 3, bw = bh * 2.2; let row = 0;
    for (let yy = y; yy < y + h; yy += bh) {
      g.beginPath(); g.moveTo(x, yy); g.lineTo(x + w, yy); g.stroke();
      const off = (row % 2) ? bw / 2 : 0;
      for (let xx = x - bw + off; xx < x + w; xx += bw) { g.beginPath(); g.moveTo(xx, yy); g.lineTo(xx, yy + bh); g.stroke(); }
      row++;
    }
  }
  _fZigzag(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 8 + rnd() * 3;
    for (let yy = y; yy < y + h + s; yy += s) {
      g.beginPath(); let up = true, started = false;
      for (let xx = x; xx <= x + w; xx += s) { const v = yy + (up ? 0 : s * 0.5); started ? g.lineTo(xx, v) : (g.moveTo(xx, v), started = true); up = !up; }
      g.stroke();
    }
  }
  _fPetals(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const s = 12 + rnd() * 4;
    for (let yy = y + s / 2; yy < y + h + s; yy += s * 0.8) for (let xx = x; xx < x + w + s; xx += s) { g.beginPath(); g.ellipse(xx, yy, s * 0.45, s * 0.28, 0, Math.PI, 0); g.stroke(); }
  }
  _fSpiralPack(g, x, y, w, h, rnd) {
    const s = 16 + rnd() * 6;
    for (let yy = y + s / 2; yy < y + h; yy += s) for (let xx = x + s / 2; xx < x + w; xx += s) { g.save(); g.translate(xx, yy); g.lineWidth = 0.8; this._mSpiral(g, s * 0.42, rnd); g.restore(); }
  }
  _fRings(g, x, y, w, h, rnd) {
    g.lineWidth = 0.9; const cx = x + w / 2, cy = y + h / 2, s = 7 + rnd() * 3, max = Math.hypot(w, h) / 2;
    for (let rad = s; rad < max; rad += s) { g.beginPath(); g.arc(cx, cy, rad, 0, Math.PI * 2); g.stroke(); }
    g.beginPath(); g.arc(cx, cy, s * 0.4, 0, Math.PI * 2); g.fill();
  }

  _mMandala(g, r, rnd) {
    const rings = 2 + Math.floor(rnd() * 2);
    for (let i = 1; i <= rings; i++) { g.beginPath(); g.arc(0, 0, r * i / (rings + 1), 0, Math.PI * 2); g.stroke(); }
    const pet = 8 + Math.floor(rnd() * 8);
    for (let i = 0; i < pet; i++) {
      const a = i / pet * Math.PI * 2;
      g.beginPath(); g.ellipse(Math.cos(a) * r * 0.78, Math.sin(a) * r * 0.78, r * 0.14, r * 0.07, a, 0, Math.PI * 2); g.stroke();
      g.beginPath(); g.arc(Math.cos(a) * r, Math.sin(a) * r, r * 0.045, 0, Math.PI * 2); g.stroke();
    }
    g.beginPath(); g.arc(0, 0, r * 0.11, 0, Math.PI * 2); g.fill();
  }

  _mPaisley(g, r, rnd) {
    g.beginPath();
    g.moveTo(0, -r * 0.1);
    g.bezierCurveTo(r * 0.95, -r * 0.6, r * 0.7, r * 0.75, 0, r * 0.6);
    g.bezierCurveTo(-r * 0.45, r * 0.5, -r * 0.5, -r * 0.1, 0, -r * 0.1);
    g.stroke();
    for (let i = 1; i <= 3; i++) { g.beginPath(); g.arc(0, r * 0.2, r * 0.11 * i, Math.PI * 0.15, Math.PI * 1.55); g.stroke(); }
  }

  _mFeather(g, r, rnd) {
    g.beginPath(); g.moveTo(0, r); g.lineTo(0, -r); g.stroke();
    const n = Math.floor(r / 6) + 4;
    for (let i = 0; i < n; i++) {
      const y = -r + (2 * r) * i / n;
      const len = r * 0.5 * (1 - Math.abs(y) / r * 0.6);
      g.beginPath(); g.moveTo(0, y); g.lineTo(len, y - len * 0.5); g.stroke();
      g.beginPath(); g.moveTo(0, y); g.lineTo(-len, y - len * 0.5); g.stroke();
    }
  }

  _mWaves(g, r, rnd) {
    const rows = 3 + Math.floor(rnd() * 3);
    for (let j = 0; j < rows; j++) {
      const yy = -r + (2 * r) * j / (rows - 1 || 1);
      g.beginPath();
      for (let x = -r; x <= r; x += 4) {
        const y = yy + Math.sin((x / r) * Math.PI * 2 + j) * r * 0.12;
        x === -r ? g.moveTo(x, y) : g.lineTo(x, y);
      }
      g.stroke();
    }
  }

  _mSpiral(g, r, rnd) {
    g.beginPath();
    const steps = 120;
    for (let s = 0; s <= steps; s++) {
      const a = s * 0.16;
      const rad = r * (1 - s / steps);
      const x = Math.cos(a) * rad, y = Math.sin(a) * rad;
      s === 0 ? g.moveTo(x, y) : g.lineTo(x, y);
    }
    g.stroke();
  }

  _mLeaf(g, r, rnd) {
    g.beginPath(); g.moveTo(0, r); g.quadraticCurveTo(r * 0.7, 0, 0, -r); g.quadraticCurveTo(-r * 0.7, 0, 0, r); g.stroke();
    g.beginPath(); g.moveTo(0, r); g.lineTo(0, -r); g.stroke();
    const n = 5;
    for (let i = 1; i < n; i++) {
      const y = r - (2 * r) * i / n;
      const w = r * 0.28 * (1 - Math.abs(y) / r);
      g.beginPath(); g.moveTo(0, y); g.lineTo(w, y - r * 0.12); g.stroke();
      g.beginPath(); g.moveTo(0, y); g.lineTo(-w, y - r * 0.12); g.stroke();
    }
  }

  _sqFill(g, r, id) {
    const s = 2 * r;
    if (id === 'dots') {
      const dg = s / 7, dot = Math.max(1, r * 0.055);
      for (let yy = -r + dg * 0.6; yy < r; yy += dg)
        for (let xx = -r + dg * 0.6; xx < r; xx += dg) { g.beginPath(); g.arc(xx, yy, dot, 0, Math.PI * 2); g.fill(); }
    } else if (id === 'scales') {
      g.lineWidth = 0.9; const sc = s / 5;
      for (let yy = -r; yy < r + sc; yy += sc * 0.62)
        for (let xx = -r - sc / 2; xx < r + sc; xx += sc) { g.beginPath(); g.arc(xx, yy, sc * 0.5, Math.PI, 2 * Math.PI); g.stroke(); }
    } else if (id === 'hatch') {
      g.lineWidth = 0.8; const st = s / 8;
      for (let d = -s; d < s; d += st) { g.beginPath(); g.moveTo(-r + d, -r); g.lineTo(-r + d + s, r); g.stroke(); }
    } else if (id === 'cross') {
      g.lineWidth = 0.7; const st = s / 7;
      for (let d = -s; d < s; d += st) { g.beginPath(); g.moveTo(-r + d, -r); g.lineTo(-r + d + s, r); g.stroke(); g.beginPath(); g.moveTo(-r + d, r); g.lineTo(-r + d + s, -r); g.stroke(); }
    } else if (id === 'hwave') {
      g.lineWidth = 0.9; const rowH = s / 6, amp = rowH * 0.32;
      for (let yy = -r + rowH * 0.5; yy < r; yy += rowH) { g.beginPath(); for (let xx = -r; xx <= r; xx += 2) { const y2 = yy + Math.sin((xx / r) * Math.PI * 3) * amp; if (xx === -r) g.moveTo(xx, y2); else g.lineTo(xx, y2); } g.stroke(); }
    } else if (id === 'vlines') {
      g.lineWidth = 0.8; const st = s / 8;
      for (let xx = -r + st * 0.5; xx < r; xx += st) { g.beginPath(); g.moveTo(xx, -r); g.lineTo(xx, r); g.stroke(); }
    } else if (id === 'rings') {
      g.lineWidth = 0.8;
      for (let rad = s / 8; rad < s * 1.4; rad += s / 7) { g.beginPath(); g.arc(-r, -r, rad, 0, Math.PI / 2); g.stroke(); }
    } else if (id === 'grid') {
      g.lineWidth = 0.7; const st = s / 6;
      for (let xx = -r; xx <= r; xx += st) { g.beginPath(); g.moveTo(xx, -r); g.lineTo(xx, r); g.stroke(); }
      for (let yy = -r; yy <= r; yy += st) { g.beginPath(); g.moveTo(-r, yy); g.lineTo(r, yy); g.stroke(); }
    }
  }

  _mSquares(g, r, rnd) {
    const s = 2 * r;
    const kinds = ['dots', 'scales', 'hatch', 'cross', 'hwave', 'vlines', 'rings', 'grid'];
    // pick two distinct fills
    let a = Math.floor(rnd() * kinds.length);
    let b = Math.floor(rnd() * kinds.length);
    if (b === a) b = (b + 1 + Math.floor(rnd() * (kinds.length - 1))) % kinds.length;
    g.lineWidth = 1.1;
    g.strokeRect(-r, -r, s, s);
    g.save();
    g.beginPath(); g.moveTo(-r, -r); g.lineTo(r, -r); g.lineTo(-r, r); g.closePath(); g.clip();
    this._sqFill(g, r, kinds[a]);
    g.restore();
    g.save();
    g.beginPath(); g.moveTo(r, -r); g.lineTo(r, r); g.lineTo(-r, r); g.closePath(); g.clip();
    this._sqFill(g, r, kinds[b]);
    g.restore();
    g.lineWidth = 1.3;
    g.beginPath(); g.moveTo(r, -r); g.lineTo(-r, r); g.stroke();
  }

  _mScallop(g, r, rnd) {
    const n = 4;
    const step = (2 * r) / n;
    for (let i = 0; i < n; i++) {
      const x = -r + step * i + step / 2;
      g.beginPath(); g.arc(x, 0, step / 2, Math.PI, 0); g.stroke();
      g.beginPath(); g.arc(x, 0, step * 0.16, 0, Math.PI * 2); g.stroke();
    }
  }

  _renderHero(t) {
    const ctx = this._ctx;
    if (!ctx || !this._art) return;
    const rb = this._cv.getBoundingClientRect();
    if (rb.bottom < -50 || rb.top > window.innerHeight + 50) return;
    const w = this._w, h = this._h, dpr = this._dpr;
    let tx = this._target.x, ty = this._target.y;
    if (!this._has) {
      const k = t * 0.00035;
      tx = w * (0.5 + 0.27 * Math.cos(k));
      ty = h * (0.5 + 0.3 * Math.sin(k * 1.3));
    }
    this._mouse.x += (tx - this._mouse.x) * 0.08;
    this._mouse.y += (ty - this._mouse.y) * 0.08;

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.globalAlpha = 0.05;
    ctx.drawImage(this._art, 0, 0, w, h);
    ctx.globalAlpha = 1;

    const R = Math.min(w, h) * 0.42;
    if (!this._spot) { this._spot = document.createElement('canvas'); this._spot.width = this._cv.width; this._spot.height = this._cv.height; }
    const sp = this._spot;
    const sg = sp.getContext('2d');
    sg.setTransform(dpr, 0, 0, dpr, 0, 0);
    sg.globalCompositeOperation = 'source-over';
    sg.clearRect(0, 0, w, h);
    sg.drawImage(this._art, 0, 0, w, h);
    sg.globalCompositeOperation = 'source-in';
    const mx = this._mouse.x, my = this._mouse.y;
    const grad = sg.createLinearGradient(mx - R, my - R, mx + R, my + R);
    grad.addColorStop(0, '#2f9e5e');
    grad.addColorStop(0.34, '#2fa79c');
    grad.addColorStop(0.6, '#4b6ee6');
    grad.addColorStop(0.82, '#e2557a');
    grad.addColorStop(1, '#e6a52e');
    sg.fillStyle = grad;
    sg.fillRect(0, 0, w, h);
    sg.globalCompositeOperation = 'destination-in';
    const rg = sg.createRadialGradient(mx, my, 0, mx, my, R);
    rg.addColorStop(0, 'rgba(0,0,0,1)');
    rg.addColorStop(0.55, 'rgba(0,0,0,0.55)');
    rg.addColorStop(1, 'rgba(0,0,0,0)');
    sg.fillStyle = rg;
    sg.fillRect(0, 0, w, h);
    sg.globalCompositeOperation = 'source-over';

    ctx.globalAlpha = 0.4;
    ctx.drawImage(sp, 0, 0, w, h);
    ctx.globalAlpha = 1;
  }

  renderVals() {
    const defs = [
      { id: 'sol', label: 'Sol', accent: '#0b6e3c' },
      { id: 'pampa', label: 'Pampa', accent: '#c4562f' },
      { id: 'tinta', label: 'Tinta', accent: '#ec1c2b' },
      { id: 'electrica', label: 'Eléctrica', accent: '#4b2ee6' },
      { id: 'marea', label: 'Marea', accent: '#0a6b63' },
      { id: 'coral', label: 'Coral', accent: '#b82e52' },
    ];
    const palettes = defs.map(d => {
      const active = this.state.theme === d.id;
      return {
        ...d,
        select: () => this.setTheme(d.id),
        pressed: active ? 'true' : 'false',
        ariaLabel: `${d.label} colour theme${active ? ' (selected)' : ''}`,
        dotStyle: `width:24px; height:24px; padding:4px; box-sizing:border-box; background-clip:content-box; border-radius:50%; cursor:pointer; background-color:${d.accent}; border:none; box-shadow:inset 0 0 0 ${active ? '2.5px' : '0'} var(--ink), inset 0 0 0 ${active ? '4px' : '1px'} var(--line); transition:box-shadow .2s ease, transform .2s ease; transform:scale(${active ? 1.12 : 1});`,
      };
    });
    const jetBtnBase = "font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.03em; border:none; cursor:pointer; padding:4px 11px; border-radius:100px; line-height:1;";
    const seg = (on) => jetBtnBase + (on ? 'background:var(--accent); color:var(--accent-ink);' : 'background:transparent; color:var(--muted);');
    const jetLight = this.state.jetLight;
    const docsLight = this.state.docsLight;
    return {
      theme: this.state.theme,
      palettes,
      heroWord: this.words[this.state.wordIndex],
      setJetLight: this.setJetLight,
      setJetDark: this.setJetDark,
      jetLightOpacity: jetLight ? 1 : 0,
      jetLightBtnStyle: seg(jetLight),
      jetDarkBtnStyle: seg(!jetLight),
      setDocsLight: this.setDocsLight,
      setDocsDark: this.setDocsDark,
      docsLightOpacity: docsLight ? 1 : 0,
      docsLightBtnStyle: seg(docsLight),
      docsDarkBtnStyle: seg(!docsLight),
    };
  }
}
</script>
</body>
</html>
