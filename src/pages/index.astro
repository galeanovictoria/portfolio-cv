            </div>
          </div>
          <div class="vr-shot" style="flex:1; overflow-y:auto; overflow-x:hidden; position:relative; background:#0f0a1e;">
            <img src="/assets/js-fullpage.jpg" alt="Jetstream template — dark mode" style="display:block; width:100%; height:auto;">
            <img src="/assets/js-fullpage-light.jpg" alt="Jetstream template — light mode" style="position:absolute; top:0; left:0; width:100%; height:auto; transition:opacity .35s ease; opacity:{{ jetLightOpacity }};">
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div style="position:relative; aspect-ratio:1/1; border:1.5px solid var(--ink); border-radius:16px; overflow:hidden; background:var(--paper);">
            <image-slot id="cs-jetstream-b" shape="rect" fit="cover" src="/assets/js-components.jpg" placeholder="CMS editor annotations"></image-slot>
          </div>
          <div style="position:relative; aspect-ratio:1/1; border:1.5px solid var(--ink); border-radius:16px; overflow:hidden; background:var(--paper);">
            <image-slot id="cs-jetstream-c" shape="rect" fit="cover" src="/assets/js-cards.jpg" placeholder="Feature cards"></image-slot>
          </div>
        </div>
      </div>
      <div style="order:1;">
        <div style="font-family:'Bricolage Grotesque',sans-serif; font-weight:800; font-size:80px; line-height:1; color:var(--accent); letter-spacing:-.03em;">02</div>
