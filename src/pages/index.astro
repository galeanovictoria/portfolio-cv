<script is:inline src="/image-slot.js"></script>
<script>
(function(){
  function remap(){
    var R = window.__resources;
    if(!R) return false;
    var slots = document.querySelectorAll('image-slot[src]');
    slots.forEach(function(el){
      var s = el.getAttribute('src');
      if(s && R[s] && s !== R[s]) el.setAttribute('src', R[s]);
    });
    return slots.length > 0;
  }
  var tries = 0;
  var iv = setInterval(function(){
    tries++;
    remap();
    if(tries > 150) clearInterval(iv);
  }, 100);
  document.addEventListener('DOMContentLoaded', remap);
})();
</script>
<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  :root{ --bg:#ece8df; --paper:#faf8f3; --ink:#16150f; --muted:#6a6459; --line:#dcd6c9; --accent:#0b6e3c; --accent-ink:#faf8f3; --band:#16150f; --band-ink:#f4efe4; }
  [data-theme="sol"]{ --bg:#ece8df; --paper:#faf8f3; --ink:#16150f; --muted:#6a6459; --line:#dcd6c9; --accent:#0b6e3c; --accent-ink:#faf8f3; --band:#16150f; --band-ink:#f4efe4; }
  [data-theme="pampa"]{ --bg:#efe6d9; --paper:#fbf6ee; --ink:#241a12; --muted:#7a6a58; --line:#e2d5c3; --accent:#c4562f; --accent-ink:#fff; --band:#241a12; --band-ink:#fbf6ee; }
  [data-theme="tinta"]{ --bg:#f1f0ed; --paper:#ffffff; --ink:#0a0a0a; --muted:#6b6b6b; --line:#dddddd; --accent:#ec1c2b; --accent-ink:#fff; --band:#0a0a0a; --band-ink:#f1f0ed; }
  [data-theme="marea"]{ --bg:#e5ecea; --paper:#f7fbfa; --ink:#0f1a19; --muted:#5f7370; --line:#cddbd8; --accent:#0a6b63; --accent-ink:#f7fbfa; --band:#0f1a19; --band-ink:#eaf3f1; }
  [data-theme="coral"]{ --bg:#f1e8e6; --paper:#fdf7f6; --ink:#1e1214; --muted:#7a6165; --line:#e3d0cd; --accent:#b82e52; --accent-ink:#fff; --band:#1e1214; --band-ink:#fbeeec; }
  [data-theme="electrica"]{ --bg:#e8e6f6; --paper:#fbfaff; --ink:#151233; --muted:#6a6785; --line:#d6d2ec; --accent:#4b2ee6; --accent-ink:#fff; --band:#151233; --band-ink:#f1effb; }
  @keyframes vr-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(7px); } }
  html, body { max-width: 100%; overflow-x: clip; }
  img, svg, canvas { max-width: 100%; }
  image-slot { display: block; width: 100%; height: 100%; max-width: 100%; overflow: hidden; }
  .vr-gallery a > div, .vr-case-media > div { max-width: 100%; overflow: hidden; }
  .vr-case > div, .vr-case-media, .vr-two > *, .vr-kitgrid > * { min-width: 0; }
  @media (max-width: 860px) {
    .vr-shot { overflow: hidden !important; }
    .vr-mock { aspect-ratio: 4/3 !important; }
    .vr-statgrid { grid-template-columns: 1fr 1fr !important; }
    .vr-statgrid > * { border-right: none !important; }
    #vr-nav { flex-wrap: wrap; row-gap: 10px; padding: 12px 20px !important; }
    #vr-nav > div { display: contents; }
    #vr-nav > div > a { order: 2; margin-left: auto; flex: 0 0 auto; white-space: nowrap; }
    #vr-nav > a:first-child { flex: 0 1 auto; min-width: 0; }
    .vr-nav-links { flex: 0 0 100%; }
    .vr-nav-links { gap: 16px !important; font-size: 11.5px !important; order: 3; justify-content: space-between; }
    .vr-nav-links a { padding: 7px 0; }
    .vr-case { grid-template-columns: 1fr !important; gap: 28px !important; padding: 44px 0 !important; }
    .vr-case .vr-case-media { order: 2 !important; }
    .vr-case .vr-case-body { order: 1 !important; }
    .vr-gallery { grid-template-columns: 1fr 1fr !important; gap: 18px !important; }
    .vr-two { grid-template-columns: 1fr !important; gap: 26px !important; padding: 28px 24px 32px !important; }
    .vr-kitgrid { grid-template-columns: 1fr !important; }
    .vr-about { grid-template-columns: 1fr !important; gap: 36px !important; }
    .vr-about-photo { max-width: 340px; }
    .vr-writing { flex-direction: column !important; align-items: flex-start !important; gap: 20px !important; }
    .vr-pad { padding-left: 20px !important; padding-right: 20px !important; }
    .vr-hero { padding: 120px 20px 56px !important; }
    .vr-hero-cta { flex-basis: 100%; }
  }
  @media (max-width: 520px) {
    .vr-gallery { grid-template-columns: 1fr !important; }
    .vr-statgrid { grid-template-columns: 1fr 1fr !important; }
    .vr-statgrid > *:nth-child(3) { border-right: none !important; }
