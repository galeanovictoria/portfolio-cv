---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import MonoLabel from "@core-elements/mono-label/MonoLabel.astro";
import TagList from "@core-elements/tag-list/TagList.astro";
import MarkdownIt from "markdown-it";

/**
 * One block of a CV — Experience, Selected work, Skills, Education. Every
 * field on an entry is optional, so the same component covers a dated role
 * with bullet points and a one-line skills group.
 */
type Item = {
  title?: string;
  titleLink?: string;
  date?: string;
  description?: string;
  detail?: string;
  body?: string;
  tags?: { text?: string }[];
  quoteText?: string;
  quoteAttribution?: string;
};

const {
  label = "",
  labelLevel = "h2",
  items = [] as Item[],
  sectionLabel,
  maxContentWidth = "lg",
  paddingHorizontal = "lg",
  paddingVertical = "xl",
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const md = MarkdownIt({ html: true });
const LabelTag = labelLevel as "h2" | "h3";

const entries = (Array.isArray(items) ? items : []).filter(
  (item) => item?.title?.trim() || item?.description?.trim() || item?.body?.trim()
);
---

<CustomSection
  class:list={["resume-section", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div class="resume-section-inner">
    {
      label && (
        <LabelTag class="resume-section-label">
          <MonoLabel
            text={label}
            tone="accent"
            size="xs"
            tracking="label"
            data-prop="label"
          />
        </LabelTag>
      )
    }

    <div
      class="resume-section-items"
      data-editable="array"
      data-prop="items"
    >
      {
        entries.map((item) => (
          <div
            class="resume-item"
            data-editable="array-item"
          >
            {(item.title || item.date) && (
              <div class="resume-item-row">
                {item.title &&
                  (item.titleLink ? (
                    <a
                      class="resume-item-title"
                      href={item.titleLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span
                        data-editable="text"
                        data-prop="title"
                      >
                        {item.title}
                      </span>
                    </a>
                  ) : (
                    <span
                      class="resume-item-title"
                      data-editable="text"
                      data-prop="title"
                    >
                      {item.title}
                    </span>
                  ))}
                {item.date && (
                  <span
                    class="resume-item-date"
                    data-editable="text"
                    data-prop="date"
                  >
                    {item.date}
                  </span>
                )}
              </div>
            )}
            {item.description && (
              <div
                class="resume-item-description"
                data-editable="text"
                data-prop="description"
                set:html={md.render(item.description)}
              />
            )}
            {item.body && (
              <div
                class="resume-item-body"
                data-editable="text"
                data-prop="body"
                set:html={md.render(item.body)}
              />
            )}
            {item.detail && (
              <p
                class="resume-item-detail"
                data-editable="text"
                data-prop="detail"
                set:html={md.renderInline(item.detail)}
              />
            )}
            <TagList
              class="resume-item-tags"
              tags={item.tags || []}
              tone="accent"
              size="xs"
              data-children-prop="tags"
            />
            {item.quoteText && (
              <blockquote class="resume-item-quote">
                <span
                  data-editable="text"
                  data-prop="quoteText"
                  set:html={md.renderInline(item.quoteText)}
                />
                {item.quoteAttribution && (
                  <cite
                    data-editable="text"
                    data-prop="quoteAttribution"
                  >
                    {item.quoteAttribution}
                  </cite>
                )}
              </blockquote>
            )}
          </div>
        ))
      }
    </div>
  </div>
</CustomSection>

<style is:global>
  @layer page-sections {
    .resume-section {
      > .outer-content > .content > .resume-section-inner {
        border-top: 1px solid var(--color-border);
        padding-top: var(--spacing-lg);

        > .resume-section-label {
          font-size: inherit;
          margin: 0 0 var(--spacing-md);
        }

        > .resume-section-items {
          display: flex;
          flex-direction: column;
          gap: var(--spacing-lg);

          > .resume-item {
            /* Roles and their bullet points should stay together when the CV is
               printed to PDF. */
            break-inside: avoid;

            > .resume-item-row {
              align-items: baseline;
              display: flex;
              gap: var(--spacing-md);
              justify-content: space-between;

              > .resume-item-title {
                color: var(--color-text-strong);
                font-size: var(--font-size-lg);
                font-weight: var(--font-weight-bold);
                text-decoration: none;

                &:hover {
                  color: var(--color-brand);
                }
              }

              > .resume-item-date {
                color: var(--color-text-muted);
                font-family: var(--font-mono);
                font-size: var(--font-size-xs);
                white-space: nowrap;
              }
            }

            > .resume-item-description,
            > .resume-item-body {
              margin-top: var(--spacing-sm);

              > *:first-child {
                margin-top: 0;
              }

              p,
              li {
                font-size: var(--font-size-md);
                line-height: 1.55;
              }

              ul,
              ol {
                margin: var(--spacing-sm) 0 0;
                padding-left: var(--spacing-lg);
              }

              li {
                margin-bottom: var(--spacing-xs);
              }
            }

            > .resume-item-detail {
              color: var(--color-text-muted);
              font-family: var(--font-mono);
              font-size: var(--font-size-xs);
              line-height: 1.6;
              margin-top: var(--spacing-sm);
            }

            > .resume-item-quote {
              border-left: 3px solid var(--color-brand);
              color: var(--color-text);
              font-family: var(--font-serif);
              font-size: var(--font-size-md);
              font-style: italic;
              line-height: 1.5;
              margin: var(--spacing-sm) 0 0;
              padding-left: var(--spacing-md);

              > cite {
                color: var(--color-text-muted);
                font-family: var(--font-mono);
                font-size: var(--font-size-xs);
                font-style: normal;
                white-space: nowrap;

                &::before {
                  content: " — ";
                }
              }
            }
          }
        }
      }
    }
  }
</style>
