---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import MonoLabel from "@core-elements/mono-label/MonoLabel.astro";
import Text from "@core-elements/text/Text.astro";

/**
 * The masthead of a case-study page: eyebrow, oversized title, serif lede, and
 * a rule-bounded strip of client / role / timeline facts.
 */
type MetaItem = {
  label?: string;
  value?: string;
};

const {
  /** Route back to the work listing, at the top of the content rather than in the header. */
  backLabel = "",
  backLink = "",
  eyebrow = "",
  heading = "",
  lede = "",
  metaItems = [] as MetaItem[],
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "3xl",
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const facts = (Array.isArray(metaItems) ? metaItems : []).filter(
  (item) => item?.label?.trim() || item?.value?.trim()
);

const hasBackLink = Boolean(backLabel?.trim() && backLink?.trim());
---

<CustomSection
  class:list={["case-study-header", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {
    hasBackLink && (
      <a
        class="case-study-header-back"
        href={backLink}
      >
        <span
          data-editable="text"
          data-prop="backLabel"
        >
          {backLabel}
        </span>
      </a>
    )
  }
  <MonoLabel
    class="case-study-header-eyebrow"
    text={eyebrow}
    tone="accent"
    size="sm"
    tracking="wide"
    data-prop="eyebrow"
  />
  <Heading
    class="case-study-header-title"
    level="h1"
    size="3xl"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="case-study-header-lede prose"
    text={lede}
    data-prop="lede"
  />

  {
    facts.length > 0 && (
      <dl
        class="case-study-header-facts"
        style={{ "--fact-columns": String(facts.length) }}
        data-editable="array"
        data-prop="metaItems"
        data-direction="row"
      >
        {facts.map((fact) => (
          <div
            class="case-study-header-fact"
            data-editable="array-item"
          >
            <dt
              data-editable="text"
              data-prop="label"
            >
              {fact.label}
            </dt>
            <dd
              data-editable="text"
              data-prop="value"
            >
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
</CustomSection>

<style is:global>
  @layer page-sections {
    .case-study-header {
      > .outer-content > .content {
        container-type: inline-size;

        /* The facts strip already closes the block with a rule; a full section's
           worth of padding under it opens a hole before the hero image. */
        padding-bottom: var(--spacing-lg);

        > .case-study-header-back {
          align-items: center;
          border: 1.5px solid var(--color-border-strong);
          border-radius: var(--radius-full);
          color: var(--color-text-strong);
          display: inline-flex;
          font-family: var(--font-mono);
          font-size: var(--font-size-sm);
          gap: var(--spacing-sm);
          letter-spacing: 0.04em;
          line-height: 1;
          margin-bottom: var(--spacing-xl);
          padding: 0.7em 1.1em;
          text-decoration: none;
          transition:
            background-color 0.2s ease,
            color 0.2s ease;

          &:hover,
          &:focus-visible {
            background-color: var(--color-bg-inverse);
            color: var(--color-text-inverse);
          }
        }

        > .case-study-header-eyebrow {
          margin-top: 0;
        }

        > .case-study-header-title {
          margin-block: var(--spacing-md) 0;
        }

        > .case-study-header-lede {
          max-width: 42rem;

          p {
            font-size: var(--font-size-xl);
          }
        }

        > .case-study-header-facts {
          border-block: 1.5px solid var(--color-border-strong);
          display: grid;
          grid-template-columns: repeat(var(--fact-columns, 4), minmax(0, 1fr));
          margin: var(--spacing-2xl) 0 0;

          > .case-study-header-fact {
            border-right: 1px solid var(--color-border);
            min-width: 0;
            padding: var(--spacing-lg) var(--spacing-md);

            &:first-child {
              padding-left: 0;
            }

            &:last-child {
              border-right: 0;
              padding-right: 0;
            }

            > dt {
              color: var(--color-text-muted);
              font-family: var(--font-mono);
              font-size: var(--font-size-xs);
              letter-spacing: 0.1em;
              text-transform: uppercase;
            }

            > dd {
              font-size: var(--font-size-md);
              font-weight: var(--font-weight-semibold);
              margin: var(--spacing-xs) 0 0;
            }
          }

          @container (max-width: 700px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));

            > .case-study-header-fact {
              padding-inline: var(--spacing-md);

              &:nth-child(2n) {
                border-right: 0;
                padding-right: 0;
              }

              &:nth-child(2n + 1) {
                padding-left: 0;
              }
            }
          }
        }
      }
    }
  }
</style>
