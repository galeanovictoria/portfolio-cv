---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Doodle from "@core-elements/doodle/Doodle.astro";
import MonoLabel from "@core-elements/mono-label/MonoLabel.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

/**
 * The closing call to action: a doodle, an eyebrow, and a display-scale
 * heading that is itself the primary link, with contact pills beneath.
 */
const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingLink = "",
  doodleSource = "",
  buttonSections = [],
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const HeadingTag = headingLevel as "h1" | "h2" | "h3";
const hasHeadingLink = Boolean(headingLink?.trim());
---

<CustomSection
  class:list={["cta-oversized", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="cta-oversized-inner"
    data-reveal
  >
    <Doodle
      source={doodleSource}
      size="xl"
      alignmentHorizontal="center"
      data-prop-src="doodleSource"
    />
    <MonoLabel
      class="cta-oversized-eyebrow"
      text={eyebrow}
      tone="accent"
      size="sm"
      tracking="wide"
      alignmentHorizontal="center"
      data-prop="eyebrow"
    />
    <HeadingTag class="cta-oversized-heading">
      {
        hasHeadingLink ? (
          <a href={headingLink}>
            <span
              data-editable="text"
              data-prop="heading"
            >
              {heading}
            </span>
          </a>
        ) : (
          <span
            data-editable="text"
            data-prop="heading"
          >
            {heading}
          </span>
        )
      }
    </HeadingTag>
    <ButtonGroup
      class="cta-oversized-buttons"
      buttonSections={buttonSections}
      alignmentHorizontal="center"
      data-children-prop="buttonSections"
    />
  </div>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  // CloudCannon edits this heading in place, so the gradient — which relies on
  // transparent text — is switched off there and hover falls back to a colour.
  const disableGradientInEditor = () => {
    if (!window.inEditorMode) return;

    document
      .querySelectorAll(".cta-oversized-heading")
      .forEach((heading) => heading.classList.add("no-gradient"));
  };

  onPageLoad(disableGradientInEditor);
</script>

<style is:global>
  @layer page-sections {
    .cta-oversized {
      > .outer-content > .content > .cta-oversized-inner {
        text-align: center;

        > .doodle {
          margin-top: 0;
        }

        > .cta-oversized-heading {
          font-size: var(--font-size-heading-4xl);
          letter-spacing: -0.035em;
          line-height: 0.95;
          margin-block: var(--spacing-md) 0;

          a {
            color: inherit;
            text-decoration: none;
          }

          /* On hover the letterforms turn transparent to reveal a wide gradient
             that slides across them — the sign-off flourish of the page.
             Skipped while editing: the heading is edited in place there, and
             transparent text under the cursor is unreadable. */
          &:not(.no-gradient) a {
            background-clip: text;
            background-image: linear-gradient(
              102deg,
              #1b5c33 0%,
              #225936 22%,
              #24614a 44%,
              #235e57 62%,
              #30417a 78%,
              #7c3544 90%,
              #7e5d1e 100%
            );
            background-position: 0% 0;
            background-size: 240% 100%;
            transition:
              background-position 1.4s cubic-bezier(0.22, 0.61, 0.36, 1),
              color 0.5s ease;
            -webkit-background-clip: text;

            &:hover,
            &:focus-visible {
              background-position: 100% 0;
              color: transparent;
            }
          }

          &.no-gradient a:hover,
          &.no-gradient a:focus-visible {
            color: var(--color-brand);
          }

          @media (prefers-reduced-motion: reduce) {
            a {
              transition: none;
            }
          }
        }

        > .cta-oversized-buttons {
          margin-top: var(--spacing-2xl);
        }
      }
    }
  }
</style>
