<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline src="/support.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=Newsreader:opsz,ital,wght@6..72,0,400&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: #0b6e3c; }
</style>
</head>
<body>
<div style="min-height:100vh; background:#ece8df; color:#16150f; font-family:'Public Sans',sans-serif;">

  <nav style="position:sticky; top:0; z-index:20; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 32px; background:color-mix(in srgb, #ece8df 80%, transparent); backdrop-filter:blur(7px);">
    <a href="/" style="display:flex; flex-direction:column; justify-content:center; gap:1px; font-family:'Bricolage Grotesque',sans-serif; font-weight:800; font-size:17px; letter-spacing:-.01em; line-height:1;">
      Victoria Roberts
      <span style="font-family:'IBM Plex Mono',monospace; font-weight:400; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#6a6459;">UX/UI Designer</span>
    </a>
    <a href="/" style="font-family:'IBM Plex Mono',monospace; font-size:12px; padding:8px 15px; border:1.5px solid #16150f; border-radius:100px;">← Back to all work</a>
  </nav>

  <header style="max-width:1080px; margin:0 auto; padding:64px 32px 0;">
    <h1 style="font-family:'Bricolage Grotesque',sans-serif; font-weight:800; font-size:clamp(40px,6.4vw,84px); line-height:.98; letter-spacing:-.03em; margin:0; text-wrap:balance;">New page heading</h1>
  </header>

  <section style="max-width:1080px; margin:0 auto; padding:40px 32px 80px;">
    <div>
      <p style="font-family:'Newsreader',serif; font-size:20px; line-height:1.6; margin:0; color:#26261c;">Page content goes here.</p>
    </div>
  </section>

  <!--
    After CloudCannon creates this file, add data-editable="source"
    attributes to the elements you want editors to change — see the
    existing pages in src/pages/ for examples, e.g.:
      data-editable="source" data-path="src/pages/your-new-file.astro" data-key="heading"
  -->

  <footer style="max-width:1080px; margin:0 auto; padding:40px 32px 60px; font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:#6a6459;">Victoria Roberts · UX/UI Designer · Dunedin, NZ</footer>
</div>
</body>
</html>
